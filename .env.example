# Model provider. Default = Particle.ai (OpenAI-compatible /chat/completions).
# Get a key, put it here, then `cp .env.example .env`.
OPENAI_API_KEY=paste-your-key-here
OPENAI_BASE_URL=https://api.particle.ai/v1
OPENAI_MODEL=deepseek-v4.1-flash

# Reasoning budget. deepseek-v4.1-flash on api.particle.ai otherwise spends the whole
# completion budget on hidden reasoning tokens and returns empty `content`.
# Values: none | minimal | low | medium | high | off (off = don't send the field at all)
OPENAI_REASONING_EFFORT=none

# Service endpoints (defaults match the README; only change these if a port is taken).
VENDOR_A2A_URL=http://127.0.0.1:8101
BUYER_A2A_URL=http://127.0.0.1:8102
VENDOR_MCP_URL=http://127.0.0.1:8123/mcp
